# Environment Configuration for Clan API
# Copy this file to .env and fill in the values

# Development database URL (for local testing with Docker Compose)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clans_db

# Cloud SQL settings (for production on Cloud Run)
CLOUD_SQL_CONNECTION_NAME=your-project:europe-west1:your-instance
DB_USER=postgres
DB_PASSWORD=your-secure-password
DB_NAME=clans_db

# GCP settings
GCP_PROJECT_ID=your-project-id
GCP_REGION=europe-west1

# App environment: development | production
APP_ENV=development
